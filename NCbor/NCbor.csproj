<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- netstandard2.0 for reach; net10.0 so modern apps get ValueTask and System.IO.Pipelines from the
		     framework instead of polyfill packages. Keep logic free of #if: tests run against net10.0 only. -->
		<TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<!-- Packaging metadata (GAPS.md GAP-12): `dotnet pack` produces a publishable package. -->
	<PropertyGroup>
		<PackageId>NCbor</PackageId>
		<Version>1.0.0</Version>
		<Authors>Sanni Modi</Authors>
		<Description>AOT-compatible, reflection-free CBOR serialization for .NET using Roslyn source generators, following System.Text.Json's patterns. Requires the companion NCbor.Generator package.</Description>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/sannimodi/cbor</PackageProjectUrl>
		<RepositoryUrl>https://github.com/sannimodi/cbor</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>cbor;serialization;source-generator;aot;system.formats.cbor</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="System.Formats.Cbor" />
	</ItemGroup>

	<!-- In-box on net10.0; polyfill packages only for netstandard2.0 (same dependencies System.Text.Json takes). -->
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="System.Threading.Tasks.Extensions" />
		<PackageReference Include="System.IO.Pipelines" />
	</ItemGroup>

	<ItemGroup>
		<None Include="../LICENSE" Pack="true" PackagePath="" />
		<None Include="../readme.md" Pack="true" PackagePath="README.md" />
	</ItemGroup>

</Project>
