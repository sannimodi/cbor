<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<!-- Packaging metadata (GAPS.md GAP-12): prepared so `dotnet pack` produces a usable package.
	     Nobody has run `dotnet nuget push` yet — confirm Authors/Version below before publishing. -->
	<PropertyGroup>
		<PackageId>NCbor</PackageId>
		<Version>1.0.0</Version>
		<Authors>atcults</Authors>
		<Description>AOT-compatible, reflection-free CBOR serialization for .NET using Roslyn source generators, following System.Text.Json's patterns. Requires the companion NCbor.Generator package.</Description>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/atcults/cbor</PackageProjectUrl>
		<RepositoryUrl>https://github.com/atcults/cbor</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>cbor;serialization;source-generator;aot;system.formats.cbor</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="System.Formats.Cbor" Version="10.0.15" />
	</ItemGroup>

	<ItemGroup>
		<None Include="../LICENSE" Pack="true" PackagePath="" />
		<None Include="../readme.md" Pack="true" PackagePath="README.md" />
	</ItemGroup>

</Project>
