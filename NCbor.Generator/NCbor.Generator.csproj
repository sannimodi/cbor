<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<IsRoslynComponent>true</IsRoslynComponent>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
	</PropertyGroup>

	<!-- Packaging metadata (GAPS.md GAP-12): prepared so `dotnet pack` produces a usable package.
	     Nobody has run `dotnet nuget push` yet — confirm Authors/Version below before publishing.
	     IncludeBuildOutput=false + the analyzers/dotnet/cs None item below is the standard pattern
	     for packing a Roslyn source generator as a NuGet analyzer (not a normal lib reference). -->
	<PropertyGroup>
		<PackageId>NCbor.Generator</PackageId>
		<Version>1.0.0</Version>
		<Authors>atcults</Authors>
		<Description>Roslyn incremental source generator that produces AOT-friendly CBOR serialization code for types registered with NCborSerializerContext. Companion package to NCbor; installs as an analyzer with no explicit ProjectReference needed.</Description>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/atcults/cbor</PackageProjectUrl>
		<RepositoryUrl>https://github.com/atcults/cbor</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>cbor;serialization;source-generator;roslyn;analyzer</PackageTags>
		<DevelopmentDependency>true</DevelopmentDependency>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<NoWarn>$(NoWarn);NU5128</NoWarn>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<!-- Lets the generator tests unit-test internal helpers (e.g. EquatableArray<T>) directly. -->
		<InternalsVisibleTo Include="NCbor.Generator.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="4.14.0" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<None Include="../LICENSE" Pack="true" PackagePath="" />
		<None Include="../readme.md" Pack="true" PackagePath="README.md" />
	</ItemGroup>

</Project>
